ARG BASE_IMAGE=python:3.12-slim
FROM ${BASE_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 10001 app
WORKDIR /app
COPY requirements.lock /app/requirements.lock
RUN grep -v -E "^(nvidia-|triton==|cuda-|torch-scatter|torch-sparse|-e )" requirements.lock > /tmp/req.txt && pip install --index-url https://download.pytorch.org/whl/cpu torch==2.14.1 && pip install -r /tmp/req.txt
COPY --chown=app:app . /app
RUN pip install --no-deps -e .
USER app
CMD ["python", "-m", "smartcity.api.worker"]
